<% content_for :title, @pattern.name %>
<% content_for :main_class, "grid" %>

<header class="page-head run">
  <h1><%= @pattern.name %></h1>
  <%= link_to "Rename", edit_pattern_path(@pattern), class: "button button--quiet" %>
</header>

<figure class="preview-figure">
  <%= pattern_preview @pattern, size: 320, period: 80 %>
  <figcaption>
    Drawn in value, paper to ink. No palette has been chosen, and the pattern is
    complete without one.
  </figcaption>
</figure>

<div class="detail stack">
  <dl class="pairs">
    <dt>Slots</dt>
    <dd><%= pluralize @pattern.slot_count, "value" %>, ranked from the ground</dd>

    <dt>Angle</dt>
    <dd><%= angle_in_words @pattern %></dd>

    <dt>Repeat</dt>
    <dd><%= pluralize @pattern.sequence.stripes.size, "stripe" %>, summing to one</dd>
  </dl>

  <table class="table repeat">
    <caption>The repeat, in order along the stripe normal.</caption>
    <thead>
      <tr>
        <th scope="col" class="numeric ordinal">#</th>
        <th scope="col">Draws</th>
        <th scope="col" class="numeric">Width</th>
      </tr>
    </thead>
    <tbody>
      <% @pattern.sequence.stripes.each_with_index do |stripe, index| %>
        <tr>
          <td class="numeric ordinal"><%= index + 1 %></td>
          <td><%= slot_name stripe.value %></td>
          <td class="numeric"><%= number_to_percentage stripe.width * 100, precision: 2 %></td>
        </tr>
      <% end %>
    </tbody>
  </table>

  <section class="slots">
    <table class="table">
      <caption>
        The slots, ranked from the ground. A slot bound to its rank is still doing value
        work; one bound to a rule takes its colour from the palette's order instead.
      </caption>
      <thead>
        <tr><th scope="col">Slot</th><th scope="col">Binding</th></tr>
      </thead>
      <tbody>
        <% @pattern.values.each do |value| %>
          <tr>
            <td><%= slot_swatch value %> <%= slot_name value %></td>
            <td><%= drawn_by?(@pattern, value) ? "By rank" : "By rank, drawn by nothing" %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </section>

  <% if @pattern.colorways.any? %>
    <section class="colorways stack">
      <% @pattern.colorways.each do |colorway| %>
        <article class="colorway">
          <h2><%= colorway.snapshot.palette_name %></h2>

          <% if colorway.invalidated? %>
            <p class="hint">
              Invalid: the pattern has <%= @pattern.slot_count %> slots and this palette has
              <%= colorway.snapshot.size %> colours. Kept, not deleted — take a slot away and it comes back.
            </p>
          <% else %>
            <%= pattern_preview colorway, size: 180, period: 45, class: "preview--inline" %>

            <table class="table">
              <thead><tr><th scope="col">Slot</th><th scope="col">Rule</th></tr></thead>
              <tbody>
                <% @pattern.values.each do |value| %>
                  <tr>
                    <td><%= slot_swatch value, colorway: colorway %> <%= slot_name value %></td>
                    <td><%= rule_name colorway.rule_for(value) %></td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          <% end %>
        </article>
      <% end %>
    </section>
  <% end %>

  <section class="tiling">
    <table class="table tiling__modes">
      <caption>
        Whether the repeat closes on itself, per output mode. A status and not a rule —
        nothing here refuses to render.
      </caption>
      <thead>
        <tr><th scope="col">Output</th><th scope="col">Tiling</th></tr>
      </thead>
      <tbody>
        <% tiling_modes(@pattern).each do |mode, tiling| %>
          <tr class="<%= "tiling--refused" unless tiling.seamless? %>">
            <td><%= tiling_mode_name mode %></td>
            <td><%= tiling_status_words tiling %></td>
          </tr>
        <% end %>
      </tbody>
    </table>

    <% unbroken = Tiling.new(@pattern, mode: :unbroken) %>
    <p class="hint"><%= unbroken.reason %></p>

    <% unless unbroken.seamless? %>
      <%= button_to "Snap to #{unbroken.fitted_angle.round(3)}°",
            pattern_tiling_path(@pattern), method: :patch, class: "button" %>
    <% end %>
  </section>

  <div class="run">
    <%= button_to "Add a slot", pattern_slot_path(@pattern), class: "button" %>
    <%= button_to "Remove the last", pattern_slot_path(@pattern), method: :delete,
          class: "button button--quiet" %>
    <%= button_to "Take away", @pattern, method: :delete, class: "button button--danger",
          form: { data: { turbo_confirm: "Take #{@pattern.name} away for good?" } } %>
  </div>
</div>
