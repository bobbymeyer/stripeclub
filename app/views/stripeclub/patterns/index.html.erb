<%= page_head "Patterns", lede: "Structure, drawn in value: how many slots, how wide each stripe, at what angle. None of these has been given a palette." do %>
  <%= link_to "Compose a pattern", new_pattern_path, class: "button button--primary" %>
<% end %>

<%# The library's filter block: a search that narrows as you type, into the
    frame below, and the registers of one-of-a-handful. Each carries the
    others, so choosing one does not drop the rest. %>
<div class="filters">
  <%= search_form patterns_path, frame: "patterns", keep: { lean: @lean, tag: @tag, sort: @sort } %>

  <%= filter_register "Leaning",
        [ [ "All", patterns_path(q: params[:q], tag: @tag, sort: @sort), @lean.nil? ],
          *Stripeclub::Pattern::LEANS.map { |key, label| [ label, patterns_path(lean: key, q: params[:q], tag: @tag, sort: @sort), @lean == key ] } ],
        name: "lean" %>

  <%# The tags are whatever the patterns carry, so a project's tag is on the
      bar the moment a pattern is given it — and no register at all until
      something is tagged, because an empty filter is a control that cannot
      be used. %>
  <% if @tags.any? %>
    <%= filter_register "Tagged",
          [ [ "All", patterns_path(q: params[:q], lean: @lean, sort: @sort), @tag.nil? ],
            *@tags.map { |tag| [ tag, patterns_path(tag: tag, q: params[:q], lean: @lean, sort: @sort), @tag == tag ] } ],
          name: "tag" %>
  <% end %>

  <%= filter_register "Sort by",
        Stripeclub::Pattern::SORTS.map { |key, label| [ label, patterns_path(sort: key, q: params[:q], lean: @lean, tag: @tag), @sort == key ] },
        name: "sort" %>
</div>

<%# Only the results live in the frame; the form stays outside it so typing
    does not replace the field under the cursor. _top, because a card inside
    is going somewhere else entirely. %>
<%= turbo_frame_tag "patterns", data: { turbo_action: "replace" }, target: "_top" do %>
  <% if @patterns.any? %>
    <ul class="grid cards pattern-cards">
      <%= render partial: "stripeclub/patterns/card", collection: @patterns, as: :pattern %>
    </ul>

    <%= render "its_swiss/shared/pagination",
          page: @page, pages: @pages, url: ->(number) { patterns_path(page: number, q: params[:q], lean: @lean, tag: @tag, sort: @sort) } %>
  <% elsif @total.zero? %>
    <p class="empty">
      No patterns yet. A pattern is structure — how many slots, how wide each stripe,
      in what order, at what angle — and carries no colour at all.
    </p>
  <% else %>
    <p class="empty">No patterns match.</p>
  <% end %>
<% end %>
