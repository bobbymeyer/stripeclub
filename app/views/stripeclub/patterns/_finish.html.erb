<%# locals: (pattern:) %>
<%# How the pattern is finished: whether it closes, and how rough it is. %>
<section class="tiling stack">
  <h2>Tiling</h2>
  <%= explain "Whether the repeat closes on itself, per output mode, on a square tile. A status " \
        "and not a rule: nothing here refuses to render, and an export free to choose its own " \
        "shape closes at any angle. Snap moves the angle to the nearest one that closes." %>

  <table class="table tiling__modes">
    <thead>
      <tr><th scope="col">Output</th><th scope="col">Tiling</th></tr>
    </thead>
    <tbody>
      <% tiling_modes(pattern).each do |mode, tiling| %>
        <tr class="<%= "tiling--refused" unless tiling.seamless? %>">
          <td><%= tiling_mode_name mode %></td>
          <td><%= tiling_status_words tiling %></td>
        </tr>
      <% end %>
    </tbody>
  </table>

  <% unbroken = Stripeclub::Tiling.new(pattern, mode: :unbroken) %>
  <p class="hint"><%= unbroken.reason %></p>

  <% unless unbroken.seamless? %>
    <%= button_to "Snap to #{unbroken.fitted_angle.round(3)}°",
          pattern_tiling_path(pattern), method: :patch, class: "button" %>
  <% end %>
</section>

<section class="imperfection stack">
  <h2>Roughness</h2>
  <%= explain "Round two: clean geometry plus post-effects. Nothing here touches the composition. " \
        "The widths stay what you typed, and making it clean gives the pattern back exactly. " \
        "The same seed draws the same imperfection every time." %>

  <% rough = pattern.imperfection || Stripeclub::Imperfection.new(pattern: pattern) %>

  <%= its_swiss_form_with model: rough, url: pattern_imperfection_path(pattern), method: :patch,
        class: "form measure" do |form| %>
    <div class="rough-grid">
      <%= form.number_field :wobble, step: 0.01, min: 0, max: 1,
            hint: "How far an edge is pushed, as a proportion of the repeat." %>
      <%= form.number_field :wobble_frequency, step: 0.005, min: 0.001, max: 4,
            hint: "How close together the wobbles are." %>
      <%= form.number_field :wobble_octaves, step: 1, min: 1, max: 5,
            hint: "How many scales of wobble are layered." %>
      <%= form.number_field :variance, step: 0.05, min: 0, max: Stripeclub::Imperfection::MOST_VARIANCE,
            hint: "How much a width may be off, as a proportion of itself. Still sums to one." %>
      <%= form.number_field :texture, step: 0.02, min: 0, max: 1,
            hint: "How strongly a tiling noise is multiplied over the whole." %>
      <%= form.number_field :texture_frequency, step: 0.05, min: 0.001, max: 4,
            hint: "How fine the texture is." %>
      <%= form.number_field :seed, step: 1 %>
    </div>

    <div class="run">
      <%= form.submit rough.persisted? ? "Set" : "Roughen" %>
      <% if rough.persisted? %>
        <%= button_to "Make it clean", pattern_imperfection_path(pattern), method: :delete,
              class: "button button--quiet" %>
      <% end %>
    </div>
  <% end %>
</section>
