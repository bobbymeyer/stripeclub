<%# locals: (pattern:) %>
<%# The structure: the repeat, the slots it draws from, and the rows. %>
<section class="repeat stack">
  <h2>Repeat</h2>
  <%= explain "The stripes in order along the stripe normal, each drawing one slot. " \
        "Widths are proportions of the repeat and sum to one." %>

  <% stripes = pattern.sequence.stripes %>
  <% equal = equal_widths?(pattern) %>
  <table class="table repeat">
    <thead>
      <tr>
        <th scope="col" class="numeric ordinal">#</th>
        <th scope="col">Draws</th>
        <% unless equal %><th scope="col" class="numeric">Width</th><% end %>
      </tr>
    </thead>
    <tbody>
      <% stripes.each_with_index do |stripe, index| %>
        <tr>
          <td class="numeric ordinal"><%= index + 1 %></td>
          <td><%= slot_name stripe.value %></td>
          <% unless equal %><td class="numeric"><%= width_in_words stripe %></td><% end %>
        </tr>
      <% end %>
    </tbody>
  </table>
</section>

<section class="slots stack">
  <h2>Slots</h2>
  <%= explain "The values, ranked from the ground: slot 0 is the lightest and the last is the darkest. " \
        "A slot is added and taken away with the two buttons, never renumbered; one nothing draws " \
        "is a rank waiting for a stripe." %>

  <table class="table">
    <thead>
      <tr><th scope="col">Slot</th><th scope="col">Drawn by</th></tr>
    </thead>
    <tbody>
      <% pattern.values.each do |value| %>
        <tr>
          <td><%= value_swatch value %> <%= slot_name value %></td>
          <td><%= drawn_by_in_words pattern, value %></td>
        </tr>
      <% end %>
    </tbody>
  </table>

  <div class="run">
    <%= button_to "Add a slot", pattern_slot_path(pattern), class: "button" %>
    <%= button_to "Remove the last", pattern_slot_path(pattern), method: :delete, class: "button button--quiet" %>
  </div>
</section>

<section class="rows stack">
  <h2>Rows</h2>
  <%= explain "Optional. A stripe at an angle has no vertical period of its own, and the row " \
        "boundaries supply one: they are what lets an axis-aligned tile carry an angle it otherwise " \
        "could not. A phase shift is relative to the band above it, so the rows are saved together." %>

  <% if pattern.rowed? %>
    <%= form_with url: pattern_row_block_path(pattern), method: :patch do |form| %>
      <table class="table">
        <thead>
          <tr>
            <th scope="col" class="numeric ordinal">#</th>
            <th scope="col">Phase</th>
            <th scope="col">Colour</th>
            <th scope="col">Scale</th>
            <th scope="col">Mirrored</th>
          </tr>
        </thead>
        <tbody>
          <% pattern.rows.each do |row| %>
            <tr>
              <td class="numeric ordinal"><%= row.position + 1 %></td>
              <td><%= row_field row, :phase, label: "Phase, row #{row.position + 1}",
                        step: 0.01, min: 0, max: 0.99 %></td>
              <td><%= row_field row, :color_offset, label: "Colour offset, row #{row.position + 1}", step: 1 %></td>
              <td class="scale">
                <%= row_field row, :width_numerator, label: "Scale numerator, row #{row.position + 1}", min: 1 %>
                <span aria-hidden="true">/</span>
                <%= row_field row, :width_denominator, label: "Scale denominator, row #{row.position + 1}", min: 1 %>
              </td>
              <td><%= row_mirror_field row %></td>
            </tr>
          <% end %>
        </tbody>
      </table>

      <%= form.submit "Save rows", class: "button" %>
    <% end %>
  <% else %>
    <p class="empty">No rows.</p>
  <% end %>

  <div class="run">
    <%= form_with url: pattern_row_block_path(pattern), method: :post, class: "form form--inline" do |divide| %>
      <div class="field field--inline">
        <label class="visually-hidden" for="row_count">How many rows</label>
        <%= divide.number_field :count, id: "row_count", value: [ pattern.rows.size, 4 ].max,
              min: 1, max: Stripeclub::Patterns::RowsController::MOST %>
      </div>
      <%= divide.submit pattern.rowed? ? "Divide again" : "Break into rows", class: "button" %>
    <% end %>

    <% if pattern.rowed? %>
      <%= button_to "Remove rows", pattern_row_block_path(pattern), method: :delete,
            class: "button button--quiet" %>
    <% end %>
  </div>
</section>
