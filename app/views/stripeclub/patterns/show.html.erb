<%# One page, four surfaces: what the pattern is made of, how it is
    finished, what it wears, how it leaves. The drawing and what is true of
    it stay in the left column on every one; the surface is the right. What
    is done daily is reached from the head, in the same position on every
    page, never by scrolling past what was done yesterday. %>
<%= page_head @pattern.name,
      sections: Stripeclub::PatternsController::SECTIONS.map { |section|
        [ section.humanize, pattern_path(@pattern, section: (section unless section == "compose")), @section == section ]
      } do %>
  <%= link_to "Rename", edit_pattern_path(@pattern), class: "button" %>
  <%= button_to "Take away", @pattern, method: :delete, class: "button button--danger",
        form: { data: { turbo_confirm: "Take #{@pattern.name} away for good?" } } %>
<% end %>

<div class="preview-column stack">
  <figure class="preview-figure">
    <%= pattern_preview @pattern, size: 320, period: 80 %>
  </figure>

  <dl class="pairs">
    <dt>Slots</dt>
    <dd><%= pluralize @pattern.slot_count, "value" %>, ranked from the ground</dd>

    <dt>Angle</dt>
    <dd><%= angle_in_words @pattern %></dd>

    <dt>Repeat</dt>
    <dd><%= repeat_in_words @pattern %></dd>
  </dl>

  <%= explain "Drawn in value, paper to ink. No palette has been chosen, and the pattern is " \
        "complete without one; a colorway is worn over it, never held by it." %>
</div>

<div class="detail stack">
  <%= render "stripeclub/patterns/#{@section}", pattern: @pattern %>
</div>
