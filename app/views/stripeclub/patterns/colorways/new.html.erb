<%= page_head "Dress #{@pattern.name}",
      lede: "#{pluralize(@pattern.slot_count, "slot")}, ranked from the ground. A palette with at least that many colours can dress it." do %>
  <%= link_to "Back to the pattern", @pattern, class: "button button--quiet" %>
<% end %>

<%# The picker is Pandatone's dresser's: the catalogue, split into what can
    dress this pattern and what cannot, on the ladder. %>
<%= render "pandatone/dresser/picker",
      slot_count: @pattern.slot_count, serving: @serving.to_a, demoted: @demoted.to_a, unreachable: @unreachable,
      noun: "this pattern",
      dress_url: ->(palette) { pattern_colorways_path(@pattern, palette_id: palette.id) },
      refresh_url: new_pattern_colorway_path(@pattern, refresh: 1) %>
